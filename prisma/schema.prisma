generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Medicine {
  id              String   @id @default(cuid())
  // Display name: "Crocin Advance 500mg Tablet"
  name            String
  // Lowercase normalized: "crocin advance 500mg tablet" — used for autocomplete + dedup
  normalizedName  String   @unique
  // Brand alone: "Crocin Advance"
  brandName       String?
  // Manufacturer: "GSK Pharmaceuticals"
  manufacturer    String?
  // Comma-separated raw salt composition string for display
  saltComposition String?
  // JSON-encoded array of structured ingredients: [{name, strength, unit}]
  ingredients     String?
  // "Tablet" | "Capsule" | "Syrup" | "Injection" | "Drops" | "Cream" | "Ointment" | "Gel" | "Inhaler"
  dosageForm      String?
  // Pack size: "10 Tablets", "100ml", "Strip of 15"
  packSize        String?
  category        String?
  description     String?
  // True if this row exists for autocomplete only and may not have live prices yet
  isCatalog       Boolean  @default(false)
  // Whether a doctor's prescription is legally required to dispense this drug
  prescriptionRequired Boolean @default(false)
  // Whether the drug is generally available for online sale in India
  soldOnline      Boolean  @default(true)
  // Plain-language uses (newline-separated bullets ok)
  uses            String?
  // How it works / mechanism summary
  howItWorks      String?
  // Common side effects (newline-separated)
  sideEffects     String?
  // Safety warnings, contraindications
  warnings        String?
  // Storage instructions
  storage         String?
  // JSON array of substitute brand names from 1mg dataset (e.g. ["Penciclav 500 mg/125 mg Tablet"])
  substitutes     String?
  // Denormalized "brand + name + salt" blob, lowercased. Postgres GENERATED
  // ALWAYS column — never written by app code. Backs the autocomplete
  // trigram + prefix indexes for sub-30ms lookups against a 200k-row table.
  searchText      String?
  // Precomputed availability: true if any PharmacyListing has inStock=true,
  // or if the row is a fresh catalog entry that has never been scraped.
  // Flipped by scrape persistence (lib/search/filter.ts).
  hasInStock      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listings     PharmacyListing[]
  saltMappings SaltMapping[]
  searchLogs   SearchLog[]

  @@index([normalizedName])
  @@index([brandName])
  @@index([saltComposition])
  @@index([hasInStock])
  // searchText prefix + trigram indexes are created as raw SQL in the
  // migration (text_pattern_ops btree + gin_trgm_ops GIN), neither of
  // which Prisma's @@index syntax can express.
}

model PharmacyListing {
  id              String   @id @default(cuid())
  medicineId      String
  medicine        Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacyName    String
  brandName       String?
  productName     String
  packSize        String?
  mrp             Float?
  sellingPrice    Float?
  discountPercent Float?
  inStock         Boolean  @default(true)
  productUrl      String?
  // Estimated delivery ETA for the requested pincode, e.g. "Tomorrow", "2-3 days"
  deliveryEta     String?
  // Whether this pharmacy can deliver to the scraped pincode
  serviceable     Boolean  @default(true)
  // Location-specific selling price (may differ from national sellingPrice for 1mg/Apollo)
  locationPrice   Float?
  // Pincode this listing was last scraped against (delivery + stock are pincode-specific)
  pincode         String?
  scrapedAt       DateTime @default(now())

  @@index([medicineId])
  @@index([pharmacyName])
  @@index([scrapedAt])
}

model JanAushadhiProduct {
  id              String   @id @default(cuid())
  drugCode        String   @unique
  genericName     String
  saltComposition String?
  unitSize        String?
  mrpBppi         Float?
  updatedAt       DateTime @updatedAt

  saltMappings SaltMapping[]
}

model JanAushadhiStore {
  id             String  @id @default(cuid())
  kendraId       String  @unique
  state          String?
  district       String?
  block          String?
  address        String?
  pincode        String?
  contactPerson  String?
  contactDetails String?
  lat            Float?
  lng            Float?

  @@index([state])
  @@index([district])
  @@index([pincode])
}

model SaltMapping {
  id                   String             @id @default(cuid())
  medicineId           String
  medicine             Medicine           @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  janAushadhiProductId String
  janAushadhiProduct   JanAushadhiProduct @relation(fields: [janAushadhiProductId], references: [id], onDelete: Cascade)
  matchConfidence      String
  createdAt            DateTime           @default(now())

  @@unique([medicineId, janAushadhiProductId])
}

model ScrapeJob {
  id               String    @id @default(cuid())
  pharmacy         String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  medicinesScraped Int?
  status           String
  errorMessage     String?
}

model SearchLog {
  id                 String    @id @default(cuid())
  query              String
  medicineId         String?
  medicine           Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  inputMethod        String
  resultsCount       Int?
  janAushadhiMatch   Boolean   @default(false)
  sid                String?
  pincode            String?
  city               String?
  state              String?
  latencyMs          Int?
  autocompletePicked Boolean   @default(false)
  refinedFromId      String?
  createdAt          DateTime  @default(now())

  impressions SearchImpression[]
  clicks      ClickLog[]

  @@index([createdAt])
  @@index([sid, createdAt])
  @@index([pincode])
  @@index([medicineId, createdAt])
}

model ClickLog {
  id                  String     @id @default(cuid())
  pharmacyName        String
  medicineId          String
  productUrl          String
  sid                 String?
  searchLogId         String?
  searchLog           SearchLog? @relation(fields: [searchLogId], references: [id], onDelete: SetNull)
  position            Int?
  sellingPriceAtClick Float?
  mrpAtClick          Float?
  isCheapestShown     Boolean    @default(false)
  isJanAushadhi       Boolean    @default(false)
  pincode             String?
  createdAt           DateTime   @default(now())

  @@index([createdAt])
  @@index([sid, createdAt])
  @@index([searchLogId])
  @@index([pharmacyName, createdAt])
}

model Session {
  sid            String   @id
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt
  userAgent      String?
  deviceClass    String?
  referrer       String?
  pincode        String?
  city           String?
  state          String?
  country        String?
  lat            Float?
  lng            Float?
  locationSource String?

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([state, city])
  @@index([pincode])
}

model PageView {
  id        String   @id @default(cuid())
  sid       String
  path      String
  referrer  String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([sid, createdAt])
  @@index([createdAt])
  @@index([path, createdAt])
}

model OcrUpload {
  id            String   @id @default(cuid())
  sid           String?
  fileSizeBytes Int?
  mimeType      String?
  medsExtracted Int      @default(0)
  succeeded     Boolean  @default(false)
  latencyMs     Int?
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([sid])
}

model ApiLog {
  id         String   @id @default(cuid())
  route      String
  method     String
  statusCode Int
  ms         Int
  createdAt  DateTime @default(now())

  @@index([createdAt, route])
  @@index([statusCode, createdAt])
}

model SearchImpression {
  id            String    @id @default(cuid())
  searchLogId   String
  searchLog     SearchLog @relation(fields: [searchLogId], references: [id], onDelete: Cascade)
  medicineId    String
  pharmacyName  String
  position      Int
  sellingPrice  Float?
  mrp           Float?
  isJanAushadhi Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([searchLogId])
  @@index([pharmacyName, createdAt])
  @@index([createdAt])
}

model PriceHistory {
  id           String   @id @default(cuid())
  medicineId   String
  pharmacyName String
  sellingPrice Float?
  mrp          Float?
  recordedAt   DateTime @default(now())

  @@index([medicineId, pharmacyName, recordedAt])
  @@index([medicineId, recordedAt])
}
