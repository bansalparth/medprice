# ─── Database ──────────────────────────────────────────────────
# Postgres (Neon, Supabase, Vercel Postgres, etc.)
# Local dev can also use SQLite by changing schema.prisma provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Gemini API (for prescription OCR) ─────────────────────────
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIza..."

# ─── Admin ─────────────────────────────────────────────────────
# Both required to access /admin. Generate password with: openssl rand -base64 24
ADMIN_USER="admin"
ADMIN_PASSWORD="changeme123"

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Scraping ──────────────────────────────────────────────────
# Number of pharmacy scrapers to run in parallel on serverless
# (Vercel). Default 3 keeps within the 60s function timeout.
# SERVERLESS_SCRAPE_LIMIT=3
